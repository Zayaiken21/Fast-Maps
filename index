/* ---------- routing ---------- */
function decodePoly(str,precision){
  var f=Math.pow(10,precision||6),i=0,lat=0,lng=0,out=[];
  while(i<str.length){
    var b,shift=0,res=0;
    do{b=str.charCodeAt(i++)-63;res|=(b&0x1f)<<shift;shift+=5;}while(b>=0x20);
    lat+=(res&1)?~(res>>1):(res>>1);shift=0;res=0;
    do{b=str.charCodeAt(i++)-63;res|=(b&0x1f)<<shift;shift+=5;}while(b>=0x20);
    lng+=(res&1)?~(res>>1):(res>>1);out.push([lat/f,lng/f]);
  }
  return out;
}
function motisPlan(params){
  return fetch(MOTIS+'v2/plan?'+new URLSearchParams(params),{headers:{Accept:'application/json'}})
    .then(function(r){
      if(r.ok)return r.json();
      return r.json().catch(function(){return {};}).then(function(j){
        throw new Error(j.error||j.message||(r.status+' '+r.statusText));});
    });
}
function osrmDrive(from,to){
  var c=from.lon+','+from.lat+';'+to.lon+','+to.lat;
  return fetch(OSRM+'driving/'+c+'?overview=full&geometries=polyline6&steps=true')
    .then(function(r){if(!r.ok)throw new Error('driving lookup failed');return r.json();})
    .then(function(j){
      if(j.code!=='Ok'||!j.routes||!j.routes.length)throw new Error('no driving route');
      return j.routes[0];
    });
}
function place(p){return p.lat+','+p.lon;}
function wheelModes(){return useShare?'WALK,BIKE,RENTAL':'WALK,BIKE';}
function activeTransitModes(){
  var on=TRANSIT_MODES.filter(function(m){return m.on;}).map(function(m){return m.id;});
  if(on.indexOf('SUBWAY')>=0)on.push('METRO','SUBURBAN');
  if(on.indexOf('RAIL')>=0)on.push('REGIONAL_RAIL','LONG_DISTANCE','HIGHSPEED_RAIL');
  return on;
}

function planSegment(from,to,when,arriveBy){
  var base={fromPlace:place(from),toPlace:place(to),time:when.toISOString(),numItineraries:5,
    pedestrianProfile:$('pedProfile').value};
  if(arriveBy)base.arriveBy='true';
  var mt=$('maxTransfers').value; if(mt!=='')base.maxTransfers=mt;

  var anyVeh=vehicles.some(function(v){return v.on;});
  var tModes=activeTransitModes();
  var jobs=[];

  if(raceWalk||anyVeh){
    jobs.push(motisPlan(Object.assign({},base,{directModes:anyVeh?wheelModes():'WALK',maxDirectTime:14400}))
      .then(function(d){return {k:'direct',d:d};},function(e){return {k:'direct',e:e};}));
  }
  if(raceTransit&&tModes.length){
    var tBase=Object.assign({},base,{transitModes:tModes.join(',')});
    jobs.push(motisPlan(Object.assign({},tBase,{preTransitModes:'WALK',postTransitModes:'WALK',directModes:'WALK'}))
      .then(function(d){return {k:'twalk',d:d};},function(e){return {k:'twalk',e:e};}));
    if(anyVeh){
      jobs.push(motisPlan(Object.assign({},tBase,{preTransitModes:wheelModes(),postTransitModes:wheelModes(),directModes:'WALK'}))
        .then(function(d){return {k:'tride',d:d};},function(e){return {k:'tride',e:e};}));
    }
  }
  if(raceCar){
    jobs.push(osrmDrive(from,to).then(function(d){return {k:'car',d:d};},function(e){return {k:'car',e:e};}));
  }
  if(!jobs.length)return Promise.reject(new Error('Turn on at least one way to travel'));

  return Promise.all(jobs).then(function(res){
    if(res.every(function(r){return r.e;}))throw new Error(res[0].e.message);
    var opts=[],notes=[];
    res.forEach(function(r){if(r.e&&r.k!=='car')notes.push(r.k);});

    function add(it,cat,label,color){
      var legs=(it.legs||[]).filter(function(l){return l.mode;});
      if(!legs.length)return null;
      var start=parseT(it.startTime)||parseT(legs[0].startTime);
      var end=parseT(it.endTime)||parseT(legs[legs.length-1].endTime);
      if(!start||!end)return null;
      var o={cat:cat,label:label,color:color,start:start,end:end,legs:legs,transfers:it.transfers||0,estimated:false,
        distance:legs.reduce(function(s,l){return s+(l.distance||0);},0)};
      opts.push(o);return o;
    }

    var bikeBase=null;
    res.forEach(function(r){
      if(r.e)return;
      if(r.k==='direct'){
        (r.d.direct||[]).forEach(function(it){
          var modes=(it.legs||[]).map(function(l){return l.mode;});
          if(modes.some(isWheel)){
            var d=(it.legs||[]).reduce(function(s,l){return s+(l.distance||0);},0);
            var t=(parseT(it.endTime)-parseT(it.startTime))/1000;
            if(!bikeBase||t<bikeBase.time)bikeBase={it:it,dist:d,time:t};
          }else if(raceWalk){
            add(it,'walk','Walk the whole way','--walk');
          }
        });
      }else if(r.k==='car'){
        var end=new Date(when.getTime()+r.d.duration*1000);
        opts.push({cat:'car',label:'Drive',color:'--car',start:new Date(when),end:end,transfers:0,estimated:false,
          distance:r.d.distance,
          legs:[{mode:'CAR',startTime:when.toISOString(),endTime:end.toISOString(),duration:r.d.duration,
            distance:r.d.distance,legGeometry:{points:r.d.geometry},
            from:{lat:from.lat,lon:from.lon,name:from.name},to:{lat:to.lat,lon:to.lon,name:to.name},
            steps:((r.d.legs&&r.d.legs[0]&&r.d.legs[0].steps)||[]).map(function(s){
              return {streetName:s.name,distance:s.distance,
                relativeDirection:((s.maneuver&&(s.maneuver.modifier||s.maneuver.type))||'').toUpperCase()};})}]});
      }else{
        (r.d.itineraries||[]).forEach(function(it){
          var modes=(it.legs||[]).map(function(l){return l.mode;});
          if(!modes.some(isTransit))return;
          if(r.k==='tride'&&modes.some(isWheel))add(it,'transit+ride','Transport + wheels','--rail');
          else if(r.k==='twalk')add(it,'transit+walk','Transport, walk each end','--rail');
        });
      }
    });

    /* one real cycling route -> a row per vehicle, timed off the actual distance */
    if(bikeBase){
      var d=bikeBase.dist, baseTime=bikeBase.time;
      vehicles.filter(function(v){return v.on;}).forEach(function(v){
        var secs = d>0 ? (d/1000)/v.speed*3600 : baseTime;
        opts.push({cat:'veh:'+v.id,label:v.name+' the whole way',color:v.color,
          start:new Date(when),end:new Date(when.getTime()+secs*1000),transfers:0,
          estimated:true,distance:d,vehicle:v,
          legs:bikeBase.it.legs.map(function(l,i,arr){
            var frac=(l.distance||0)/(d||1);
            var prior=arr.slice(0,i).reduce(function(s,x){return s+(x.distance||0);},0)/(d||1);
            var s=new Date(when.getTime()+prior*secs*1000);
            var e=new Date(when.getTime()+(prior+frac)*secs*1000);
            return Object.assign({},l,{startTime:s.toISOString(),endTime:e.toISOString(),duration:(e-s)/1000});
          })});
      });
    }

    /* best per category plus transit runners-up */
    var best={};
    opts.forEach(function(o){if(!best[o.cat]||o.end<best[o.cat].end)best[o.cat]=o;});
    var chosen=Object.keys(best).map(function(k){return best[k];});
    opts.sort(function(a,b){return a.end-b.end;}).forEach(function(o){
      if(chosen.length<9&&chosen.indexOf(o)<0&&o.cat.indexOf('transit')===0&&
        !chosen.some(function(c){return c.cat===o.cat&&Math.abs(c.end-o.end)<180000;}))chosen.push(o);
    });
    chosen.sort(function(a,b){return a.end-b.end;});
    chosen.notes=notes;
    return chosen;
  });
}

/* ---------- run ---------- */
var current=[],endpoints=null;
$('goBtn').onclick=run;

function run(){
  $('goBtn').disabled=true;
  setStatus('<span class="spin"></span>Finding your points…');
  $('board').hidden=true;drawn.clearLayers();$('openExt').hidden=true;

  var from,to,pit,when,arriveBy;
  resolve('from','fromIn',true).then(function(f){from=f;return resolve('to','toIn',true);})
  .then(function(t){to=t;return $('pitBody').hidden?null:resolve('pit','pitIn',false);})
  .then(function(p){
    pit=p;endpoints={from:from,to:to,pit:pit};
    arriveBy=$('timeMode').value==='arrive';
    when=$('when').value?new Date($('when').value):new Date();
    setStatus('<span class="spin"></span>Racing every way from '+esc(from.name)+' to '+esc(to.name)+'…');
    if(!pit)return planSegment(from,to,when,arriveBy);
    return planSegment(from,pit,when,false).then(function(leg1){
      if(!leg1.length)throw new Error('No route found to the Pit Stop');
      var dwellMin=parseInt($('dwell').value,10);
      var depart2=new Date(leg1[0].end.getTime()+dwellMin*60000);
      return planSegment(pit,to,depart2,false).then(function(leg2){
        if(!leg2.length)throw new Error('No onward route from the Pit Stop');
        return leg2.map(function(o2){
          var o1=leg1.filter(function(x){return x.cat===o2.cat;})[0]||leg1[0];
          var shift=leg1[0].end.getTime()-o1.end.getTime();
          return {cat:o2.cat,label:o2.label,color:o2.color,vehicle:o2.vehicle,
            start:new Date(o1.start.getTime()+shift),end:o2.end,
            legs:o1.legs.concat(o2.legs),transfers:o1.transfers+o2.transfers,
            estimated:o1.estimated||o2.estimated,distance:(o1.distance||0)+(o2.distance||0),
            pit:{arrive:o1.end,depart:depart2,dwell:dwellMin}};
        }).sort(function(a,b){return a.end-b.end;});
      });
    });
  })
  .then(function(options){
    if(!options||!options.length)throw new Error('Nothing came back for these two points');
    current=options;render(options);select(0);
    var w=options[0];
    var msg=options.length+' way'+(options.length>1?'s':'')+' to make this trip. Fastest is <strong>'+
      esc(w.label)+'</strong> — arrives '+hhmm(w.end)+'.';
    if(options.notes&&options.notes.length)
      msg+=' Public transport came back empty here — that usually means no open feed covers this area yet.';
    setStatus(msg);
    $('openExt').hidden=false;
  })
  .catch(function(err){
    setStatus('Could not plan this: '+esc(err.message)+'.<br>Walking, cycling and driving work anywhere; public transport depends on whether an open feed covers the area.',true);
  })
  .then(function(){$('goBtn').disabled=false;});
}
function setStatus(html,isErr){var s=$('status');s.innerHTML=html;s.className='status'+(isErr?' err':'');}

$('openExt').onclick=function(){
  if(!endpoints)return;
  var f=endpoints.from,t=endpoints.to;
  var apple=/iPhone|iPad|Mac/.test(navigator.userAgent);
  var url=apple?'https://maps.apple.com/?saddr='+f.lat+','+f.lon+'&daddr='+t.lat+','+t.lon
    :'https://www.google.com/maps/dir/?api=1&origin='+f.lat+','+f.lon+'&destination='+t.lat+','+t.lon;
  window.open(url,'_blank','noopener');
};

/* ---------- render ---------- */
function legColor(o,l){
  return (o.vehicle&&isWheel(l.mode))?cssVar(o.vehicle.color):cssVar(modeVar(l.mode));
}
function legLabel(o,l){
  if(isTransit(l.mode))return l.routeShortName||modeLabel(l.mode);
  if(isWheel(l.mode))return o.vehicle?o.vehicle.name:'Bike';
  if(l.mode==='CAR')return 'Drive';
  return 'Walk';
}
function render(options){
  var t0=Math.min.apply(null,options.map(function(o){return o.start.getTime();}));
  var t1=Math.max.apply(null,options.map(function(o){return o.end.getTime();}));
  var span=Math.max(t1-t0,60000);
  $('axis').innerHTML='<span class="mono">'+hhmm(new Date(t0))+'</span><span>arrival →</span><span class="mono">'+hhmm(new Date(t1))+'</span>';
  $('raceRange').textContent=dur((t1-t0)/1000)+' between first and last arrival';

  var box=$('opts');box.innerHTML='';
  options.forEach(function(o,i){
    var el=document.createElement('div');
    el.className='opt'+(i===0?' best':'');el.tabIndex=0;el.setAttribute('role','button');
    var segs=o.legs.map(function(l){
      var s=parseT(l.startTime),e=parseT(l.endTime);if(!s||!e)return'';
      var left=(s-t0)/span*100,width=Math.max((e-s)/span*100,1.2);
      var nm=l.routeShortName||'';
      return '<div class="seg" style="left:'+left+'%;width:'+width+'%;background:'+legColor(o,l)+'" title="'+
        esc(modeLabel(l.mode)+(nm?' '+nm:''))+'">'+(width>9?esc(nm||modeLabel(l.mode)):'')+'</div>';
    }).join('');
    var chips=o.legs.map(function(l){
      var secs=l.duration||((parseT(l.endTime)-parseT(l.startTime))/1000);
      return '<span class="lchip"><span class="dot" style="background:'+legColor(o,l)+'"></span>'+
        esc(legLabel(o,l))+' '+Math.max(1,Math.round(secs/60))+'m</span>';
    }).join('<span style="color:var(--line)">›</span>');

    el.innerHTML='<div class="opt-top"><div><span class="opt-name">'+esc(o.label)+'</span>'+
      (i===0?'<span class="badge">Fastest</span>':'')+(o.estimated?'<span class="badge grey">Estimated</span>':'')+
      '</div><div class="dur mono">'+dur((o.end-o.start)/1000)+'</div></div>'+
      '<div class="times mono">'+hhmm(o.start)+' → '+hhmm(o.end)+
        (o.distance?' · '+distTxt(o.distance):'')+
        (o.transfers?' · '+o.transfers+' transfer'+(o.transfers>1?'s':''):'')+
        (o.pit?' · Pit Stop '+hhmm(o.pit.arrive)+'–'+hhmm(o.pit.depart):'')+'</div>'+
      '<div class="track">'+segs+'</div><div class="legs">'+chips+'</div>'+
      '<div class="stepbar"><button class="ghost" data-steps>Step by step</button></div>'+
      '<div class="steps" hidden></div>';

    el.querySelector('[data-steps]').onclick=function(ev){
      ev.stopPropagation();
      var pane=el.querySelector('.steps');
      if(pane.hidden){pane.innerHTML=stepsHtml(o);pane.hidden=false;ev.target.textContent='Hide steps';}
      else{pane.hidden=true;ev.target.textContent='Step by step';}
      select(i);
    };
    el.onclick=function(){select(i);};
    el.onkeydown=function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();select(i);}};
    box.appendChild(el);
  });
  $('board').hidden=false;
}
function stepsHtml(o){
  var parts=o.legs.map(function(l){
    var s=parseT(l.startTime),e=parseT(l.endTime);
    var head;
    if(isTransit(l.mode)){
      head='<b>'+esc((l.routeShortName?l.routeShortName+' ':'')+modeLabel(l.mode))+'</b> from '+
        esc((l.from&&l.from.name)||'stop')+' '+(s?hhmm(s):'')+' → '+esc((l.to&&l.to.name)||'stop')+' '+(e?hhmm(e):'');
      if(l.headsign)head+=' <span style="opacity:.75">towards '+esc(l.headsign)+'</span>';
    }else{
      head='<b>'+esc(legLabel(o,l))+'</b> '+distTxt(l.distance)+' to '+esc((l.to&&l.to.name)||'the next point');
    }
    var sub=(l.steps||[]).filter(function(st){return st.streetName&&st.streetName!=='<unknown>';}).slice(0,12)
      .map(function(st){return '<li>'+esc((st.relativeDirection||'').toLowerCase().replace(/_/g,' '))+' onto '+
        esc(st.streetName)+' · '+distTxt(st.distance)+'</li>';}).join('');
    return '<li>'+head+(sub?'<ol style="margin-top:4px">'+sub+'</ol>':'')+'</li>';
  }).join('');
  var note='';
  if(o.vehicle)note='<p class="hint">Routed on the real cycling network, then timed at '+o.vehicle.speed+
    ' km/h over '+distTxt(o.distance)+'. Change the speed on the vehicle chip to re-time it.</p>';
  if(o.cat==='car')note='<p class="hint">Free-flow driving time — no live traffic exists in the free data.</p>';
  if(o.cat==='transit+ride')note='<p class="hint">First and last mile are timed at standard cycling speed, so the connection is never optimistic.</p>';
  return '<ol>'+parts+'</ol>'+note;
}
function select(i){
  var kids=$('opts').children;
  for(var k=0;k<kids.length;k++)kids[k].setAttribute('aria-selected',String(k===i));
  drawLegs(current[i]);
}
function drawLegs(o){
  drawn.clearLayers();var bounds=[];
  o.legs.forEach(function(l){
    var color=legColor(o,l),pts=null;
    if(l.legGeometry&&l.legGeometry.points)pts=decodePoly(l.legGeometry.points,6);
    if(pts&&pts.length>1){
      L.polyline(pts,{color:color,weight:isTransit(l.mode)?6:5,opacity:.9,
        dashArray:l.mode==='WALK'?'2 8':null,lineCap:'round'}).addTo(drawn);
      pts.forEach(function(p){bounds.push(p);});
    }else if(l.from&&l.to&&l.from.lat!=null){
      var seg=[[l.from.lat,l.from.lon],[l.to.lat,l.to.lon]];
      L.polyline(seg,{color:color,weight:4,opacity:.7,dashArray:'6 6'}).addTo(drawn);
      seg.forEach(function(p){bounds.push(p);});
    }
  });
  o.legs.forEach(function(l){
    if(isTransit(l.mode)&&l.from&&l.from.lat!=null)
      L.circleMarker([l.from.lat,l.from.lon],{radius:4,color:cssVar(modeVar(l.mode)),weight:2,fillColor:'#fff',fillOpacity:1})
        .bindTooltip(l.from.name||'Stop',{direction:'top'}).addTo(drawn);
  });
  var ends=[];
  if(endpoints){
    ends.push([endpoints.from,'Start']);
    if(endpoints.pit)ends.push([endpoints.pit,'Pit Stop'+(o.pit?' · '+o.pit.dwell+' min':'')]);
    ends.push([endpoints.to,'Destination']);
  }
  ends.forEach(function(pair){
    var p=pair[0],label=pair[1];
    if(!p||p.lat==null)return;
    L.circleMarker([p.lat,p.lon],{radius:8,color:label.indexOf('Pit')===0?cssVar('--signal'):'#131A2E',
      weight:3,fillColor:'#fff',fillOpacity:1}).bindTooltip(label,{direction:'top'}).addTo(drawn);
    bounds.push([p.lat,p.lon]);
  });
  if(bounds.length)map.fitBounds(L.latLngBounds(bounds),{padding:[28,28]});
}
</script>
