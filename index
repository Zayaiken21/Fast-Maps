<!DOCTYPE index.html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Fast Maps — every way there, raced</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#131A2E;--ink-soft:#4B5675;--paper:#EEF1F5;--card:#FFF;--line:#D9DFE9;--signal:#FF5A1F;
  --walk:#7A879E;--bike:#0FA3A3;--ebike:#0B8FD4;--escooter:#D6409F;--moped:#B45309;--car:#8B5CF6;
  --rail:#F5A524;--bus:#5B6EF5;--ferry:#0891B2;--other:#6E7BA0;
  --r:14px;--sh:0 8px 26px rgba(19,26,46,.10);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{background:var(--paper);color:var(--ink);font-family:"IBM Plex Sans",system-ui,-apple-system,sans-serif;
  font-size:15px;line-height:1.45;-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:"Space Grotesk",system-ui,sans-serif;letter-spacing:-.02em;margin:0}
.mono{font-family:"IBM Plex Mono",ui-monospace,monospace;font-variant-numeric:tabular-nums}
.wrap{max-width:1180px;margin:0 auto;padding:14px 14px calc(40px + env(safe-area-inset-bottom))}
header.mast{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.logo{font-family:"Space Grotesk";font-weight:700;font-size:26px;line-height:1}
.logo em{font-style:normal;color:var(--signal)}
.tag{font-size:12.5px;color:var(--ink-soft);flex:1 1 200px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:13px;box-shadow:var(--sh)}
.field{position:relative;margin-bottom:9px}
label{display:block;font-size:10.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:4px}
.inputrow{display:flex;gap:7px}
input[type=text],input[type=number],input[type=datetime-local],select{width:100%;padding:12px;border:1px solid var(--line);
  border-radius:11px;background:#FBFCFE;color:var(--ink);font:inherit;-webkit-appearance:none;appearance:none}
select{background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8'><path d='M1 1l5 5 5-5' fill='none' stroke='%234B5675' stroke-width='1.6'/></svg>");
  background-repeat:no-repeat;background-position:right 12px center}
input:focus,select:focus,button:focus-visible{outline:2px solid var(--signal);outline-offset:1px}
.pin{flex:0 0 auto;width:46px;display:grid;place-items:center;border:1px solid var(--line);border-radius:11px;background:#FBFCFE;font-size:17px}
.swap{display:flex;justify-content:flex-end;margin:-4px 0 6px}
.sugg{position:absolute;z-index:1200;top:100%;left:0;right:0;background:#fff;border:1px solid var(--line);
  border-radius:11px;margin-top:4px;max-height:250px;overflow:auto;box-shadow:var(--sh)}
.sugg div{padding:10px 12px;cursor:pointer;font-size:14px;border-bottom:1px solid #F1F4F8}
.sugg div:last-child{border-bottom:0}
.sugg .kind{float:right;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-left:8px}
.sugg small{display:block;color:var(--ink-soft);font-size:12px}
.chips{display:flex;gap:7px;flex-wrap:wrap;margin:4px 0 12px}
.chip{border:1px solid var(--line);background:#FBFCFE;border-radius:999px;padding:8px 13px;font-size:13.5px;cursor:pointer;
  display:inline-flex;align-items:center;gap:7px;user-select:none;color:var(--ink)}
.chip[aria-pressed=true]{background:var(--ink);color:#fff;border-color:var(--ink)}
.chip .dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto}
.chip .kmh{font-size:11px;opacity:.7}
.chip .edit{margin-left:2px;opacity:.6;font-size:12px}
.grid2{display:grid;gap:9px;grid-template-columns:1fr}
@media(min-width:640px){.grid2{grid-template-columns:1fr 1fr}}
button{font:inherit;cursor:pointer;border-radius:11px;border:1px solid var(--line);background:#fff;padding:10px 14px;color:var(--ink)}
button.go{background:var(--ink);color:#fff;border-color:var(--ink);font-weight:600;width:100%;padding:14px;font-size:16px;margin-top:6px}
button.go:disabled{opacity:.55;cursor:default}
button.ghost{font-size:13px;padding:9px 12px}
.sec{margin-top:12px;border-top:1px dashed var(--line);padding-top:11px}
.sec-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:6px}
.sec-head h3{font-size:14px}
.hint{font-size:12px;color:var(--ink-soft);margin-top:8px}
.status{margin-top:13px;padding:13px;border:1px dashed var(--line);border-radius:var(--r);background:#F7F9FC;font-size:14px;color:var(--ink-soft)}
.status strong{color:var(--ink)}
.err{border-color:#F0A8A8;background:#FEF5F5;color:#8A2B2B}
.spin{display:inline-block;width:13px;height:13px;border:2px solid var(--line);border-top-color:var(--ink);border-radius:50%;
  animation:sp .7s linear infinite;vertical-align:-2px;margin-right:6px}
@keyframes sp{to{transform:rotate(360deg)}}
#map{height:300px;border-radius:var(--r);border:1px solid var(--line);margin-top:13px;background:#DFE5EC;position:relative;z-index:1}
@media(min-width:900px){#map{height:440px}}
.maptools{display:flex;gap:7px;margin-top:8px;flex-wrap:wrap}
.board{margin-top:16px}
.board-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px;gap:10px;flex-wrap:wrap}
.board-head h2{font-size:19px}
.axis{display:flex;justify-content:space-between;font-size:11px;color:var(--ink-soft);border-bottom:1px solid var(--line);padding-bottom:4px;margin-bottom:7px}
.opt{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:9px;cursor:pointer;box-shadow:0 2px 8px rgba(19,26,46,.05)}
.opt[aria-selected=true]{border-color:var(--ink);box-shadow:0 0 0 1px var(--ink)}
.opt.best{border-left:4px solid var(--signal)}
.opt-top{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.opt-name{font-family:"Space Grotesk";font-weight:700;font-size:15.5px}
.badge{display:inline-block;font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;background:var(--signal);
  color:#fff;border-radius:999px;padding:2px 7px;margin-left:6px;vertical-align:2px}
.badge.grey{background:#E7EBF2;color:var(--ink-soft)}
.dur{font-size:18px;font-weight:600;white-space:nowrap}
.times{font-size:12px;color:var(--ink-soft)}
.track{position:relative;height:20px;margin:9px 0 7px;background:#F2F5F9;border-radius:6px;overflow:hidden}
.seg{position:absolute;top:0;height:100%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600;
  color:#fff;overflow:hidden;white-space:nowrap}
.legs{font-size:12.5px;display:flex;gap:5px;flex-wrap:wrap;align-items:center}
.lchip{display:inline-flex;align-items:center;gap:5px;background:#F2F5F9;border-radius:999px;padding:3px 9px;font-size:12px}
.dot{width:8px;height:8px;border-radius:50%;flex:0 0 auto}
.steps{margin-top:10px;border-top:1px solid var(--line);padding-top:9px;font-size:13px}
.steps[hidden]{display:none}
.steps ol{margin:0;padding-left:18px}
.steps li{margin-bottom:5px;color:var(--ink-soft)}
.steps li b{color:var(--ink);font-weight:600}
.stepbar{display:flex;gap:7px;margin-top:9px;flex-wrap:wrap}
dialog{border:1px solid var(--line);border-radius:var(--r);padding:16px;max-width:380px;width:92%;box-shadow:var(--sh)}
dialog::backdrop{background:rgba(19,26,46,.45)}
footer{margin-top:24px;font-size:12px;color:var(--ink-soft);line-height:1.6}
footer a{color:var(--ink-soft)}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div class="wrap">

<header class="mast">
  <div class="logo">Fast<em>.</em>Maps</div>
  <div class="tag">Every way there, raced side by side — and the mixes the other apps won't show you.</div>
</header>

<div class="panel">
  <div class="field">
    <label for="fromIn">Start</label>
    <div class="inputrow">
      <input type="text" id="fromIn" placeholder="Address, place, or station" autocomplete="off" inputmode="search">
      <button class="pin" id="locBtn" title="Use my location" aria-label="Use my location">◎</button>
    </div>
    <div class="sugg" id="fromSugg" hidden></div>
  </div>

  <div class="swap"><button class="ghost" id="swapBtn">⇅ Swap</button></div>

  <div class="field">
    <label for="toIn">Destination</label>
    <input type="text" id="toIn" placeholder="Where you're headed" autocomplete="off" inputmode="search">
    <div class="sugg" id="toSugg" hidden></div>
  </div>

  <div class="sec">
    <div class="sec-head">
      <h3>Pit Stop <span style="font-weight:400;color:var(--ink-soft);font-size:12.5px">— an errand on the way</span></h3>
      <button class="ghost" id="pitToggle" aria-expanded="false">Add</button>
    </div>
    <div id="pitBody" hidden>
      <div class="field">
        <label for="pitIn">Pit Stop location</label>
        <input type="text" id="pitIn" placeholder="Coffee, pharmacy, a friend's place" autocomplete="off">
        <div class="sugg" id="pitSugg" hidden></div>
      </div>
      <div class="field">
        <label for="dwell">Time spent there</label>
        <select id="dwell">
          <option value="5">5 minutes</option><option value="10" selected>10 minutes</option>
          <option value="20">20 minutes</option><option value="30">30 minutes</option><option value="60">1 hour</option>
        </select>
      </div>
    </div>
  </div>

  <div class="sec">
    <div class="sec-head">
      <h3>Your vehicles</h3>
      <button class="ghost" id="addVeh">+ Add vehicle</button>
    </div>
    <div class="chips" id="vehChips"></div>
    <p class="hint">Tap to race it, tap the pencil to change its speed. Times come from the real cycling route distance divided by your speed.</p>
  </div>

  <div class="sec">
    <div class="sec-head"><h3>Public transport</h3></div>
    <div class="chips" id="transitChips"></div>
    <div class="grid2">
      <div class="field" style="margin:0">
        <label for="maxTransfers">Max transfers</label>
        <select id="maxTransfers">
          <option value="">No limit</option><option value="0">Direct only</option>
          <option value="1">1</option><option value="2">2</option><option value="3">3</option>
        </select>
      </div>
      <div class="field" style="margin:0">
        <label for="pedProfile">Walking profile</label>
        <select id="pedProfile">
          <option value="FOOT" selected>Standard</option>
          <option value="WHEELCHAIR">Step-free / wheelchair</option>
        </select>
      </div>
    </div>
    <label style="margin-top:10px">Share vehicles</label>
    <div class="chips" id="shareChips"></div>
  </div>

  <div class="sec">
    <div class="grid2">
      <div class="field" style="margin:0">
        <label for="when">Leave at</label>
        <input type="datetime-local" id="when">
      </div>
      <div class="field" style="margin:0">
        <label for="timeMode">Time means</label>
        <select id="timeMode">
          <option value="depart" selected>Depart at this time</option>
          <option value="arrive">Arrive by this time</option>
        </select>
      </div>
    </div>
  </div>

  <button class="go" id="goBtn">Find the fastest way</button>
  <p class="hint">Type an address and pick it from the list, or just hit the button — Fast Maps resolves the best match itself.</p>
</div>

<div class="status" id="status">
  <strong>Where to?</strong> Fast Maps races walking, every vehicle you own, driving, public transport, and transport-plus-wheels combos, then sorts by who actually arrives first.
</div>

<div id="map"></div>
<div class="maptools">
  <button class="ghost" id="recenter">Recenter on me</button>
  <button class="ghost" id="followBtn" aria-pressed="false">Follow my position</button>
  <button class="ghost" id="openExt" hidden>Open route in Maps</button>
</div>

<div class="board" id="board" hidden>
  <div class="board-head">
    <h2>The race</h2>
    <div class="times mono" id="raceRange"></div>
  </div>
  <div class="axis" id="axis"></div>
  <div id="opts"></div>
</div>

<footer>
  Addresses from <a href="https://nominatim.openstreetmap.org/" target="_blank" rel="noopener">Nominatim</a>.
  Public transport and street routing by <a href="https://transitous.org/" target="_blank" rel="noopener">Transitous</a> (MOTIS) —
  feeds listed at <a href="https://transitous.org/sources/" target="_blank" rel="noopener">transitous.org/sources</a>.
  Driving by the <a href="https://project-osrm.org/" target="_blank" rel="noopener">OSRM</a> demo server.
  Map data and tiles &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap contributors</a>.
  Driving times are free-flow — no live traffic exists in these free feeds. Transitous and the OSRM demo are volunteer-run and intended for non-commercial, open-source use.
</footer>
</div>

<dialog id="vehDlg">
  <h3 style="margin-bottom:10px">Vehicle</h3>
  <div class="field"><label for="vName">Name</label><input type="text" id="vName" placeholder="My e-bike"></div>
  <div class="field"><label for="vSpeed">Average speed (km/h)</label><input type="number" id="vSpeed" min="3" max="60" step="0.5"></div>
  <div class="field"><label for="vColor">Colour</label>
    <select id="vColor">
      <option value="--bike">Teal</option><option value="--ebike">Blue</option>
      <option value="--escooter">Magenta</option><option value="--moped">Amber</option><option value="--car">Violet</option>
    </select>
  </div>
  <div style="display:flex;gap:8px;margin-top:12px">
    <button id="vDelete" class="ghost" style="color:#B3261E">Delete</button>
    <span style="flex:1"></span>
    <button id="vCancel" class="ghost">Cancel</button>
    <button id="vSave" style="background:var(--ink);color:#fff;border-color:var(--ink)">Save</button>
  </div>
  <p class="hint">Speeds are door-to-door averages including stops and lights. A fit cyclist is 16, a class-1 e-bike about 22, a stand-up e-scooter about 18.</p>
</dialog>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
"use strict";
var MOTIS='https://api.transitous.org/api/';
var NOM='https://nominatim.openstreetmap.org/';
var OSRM='https://router.project-osrm.org/route/v1/';

/* ---------- storage (safe if blocked) ---------- */
function load(k,d){try{var v=localStorage.getItem(k);return v?JSON.parse(v):d;}catch(e){return d;}}
function save(k,v){try{localStorage.setItem(k,JSON.stringify(v));}catch(e){}}

/* ---------- map ---------- */
var map=L.map('map',{zoomControl:true}).setView([40.577,-73.96],12);
L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap'}).addTo(map);
var drawn=L.layerGroup().addTo(map);
var meMarker=null,meCircle=null,watchId=null;

/* ---------- utils ---------- */
function $(id){return document.getElementById(id);}
function pad(n){return String(n).padStart(2,'0');}
function hhmm(d){return pad(d.getHours())+':'+pad(d.getMinutes());}
function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
function dur(sec){var m=Math.max(1,Math.round(sec/60));return m<60?m+' min':Math.floor(m/60)+'h '+pad(m%60);}
function distTxt(m){if(m==null||isNaN(m)||m<=0)return'';return m<1000?Math.round(m)+' m':(m/1000).toFixed(m<10000?1:0)+' km';}
function parseT(v){if(v==null)return null;if(typeof v==='number')return new Date(v<1e12?v*1000:v);var d=new Date(v);return isNaN(d)?null:d;}
function cssVar(n){return getComputedStyle(document.documentElement).getPropertyValue(n).trim();}
function isTransit(m){return ['WALK','BIKE','CAR','RENTAL','BIKE_RENTAL','SCOOTER','ODM'].indexOf(m)<0;}
function isWheel(m){return ['BIKE','RENTAL','BIKE_RENTAL','SCOOTER'].indexOf(m)>=0;}
function modeVar(m){
  var t={WALK:'--walk',BIKE:'--bike',RENTAL:'--escooter',BIKE_RENTAL:'--escooter',SCOOTER:'--escooter',CAR:'--car',
    RAIL:'--rail',HIGHSPEED_RAIL:'--rail',LONG_DISTANCE:'--rail',NIGHT_RAIL:'--rail',REGIONAL_RAIL:'--rail',
    REGIONAL_FAST_RAIL:'--rail',SUBWAY:'--rail',METRO:'--rail',SUBURBAN:'--rail',TRAM:'--rail',
    BUS:'--bus',COACH:'--bus',FERRY:'--ferry',AERIAL_LIFT:'--other',ODM:'--other'};
  return t[m]||'--other';
}
function modeLabel(m){
  var t={SUBWAY:'Subway',METRO:'Subway',SUBURBAN:'Commuter rail',RAIL:'Train',REGIONAL_RAIL:'Regional train',
    REGIONAL_FAST_RAIL:'Fast regional',HIGHSPEED_RAIL:'High-speed',LONG_DISTANCE:'Intercity',NIGHT_RAIL:'Night train',
    TRAM:'Tram',BUS:'Bus',COACH:'Coach',FERRY:'Ferry',AERIAL_LIFT:'Cable car',ODM:'On-demand'};
  return t[m]||m.toLowerCase().replace(/_/g,' ');
}

/* ---------- vehicles ---------- */
var DEFAULT_VEHICLES=[
  {id:'bike',    name:'Bike',      speed:16, color:'--bike',     on:true},
  {id:'ebike',   name:'E-bike',    speed:22, color:'--ebike',    on:true},
  {id:'escooter',name:'E-scooter', speed:18, color:'--escooter', on:true}
];
var vehicles=load('fm.vehicles',null)||DEFAULT_VEHICLES.slice();
var raceWalk=load('fm.walk',true), raceCar=load('fm.car',true), raceTransit=load('fm.transit',true);
var TRANSIT_MODES=[
  {id:'RAIL',   label:'Train',  color:'--rail',  on:true},
  {id:'SUBWAY', label:'Subway', color:'--rail',  on:true},
  {id:'TRAM',   label:'Tram',   color:'--rail',  on:true},
  {id:'BUS',    label:'Bus',    color:'--bus',   on:true},
  {id:'FERRY',  label:'Ferry',  color:'--ferry', on:true}
];
var tOn=load('fm.tmodes',null); if(tOn)TRANSIT_MODES.forEach(function(m){if(tOn[m.id]!=null)m.on=tOn[m.id];});
var useShare=load('fm.share',true);

function renderChips(){
  var box=$('vehChips'); box.innerHTML='';
  function chip(label,color,on,onClick,extra){
    var b=document.createElement('button');
    b.type='button';b.className='chip';b.setAttribute('aria-pressed',String(on));
    b.innerHTML='<span class="dot" style="background:'+cssVar(color)+'"></span>'+esc(label)+(extra||'');
    b.onclick=onClick; return b;
  }
  box.appendChild(chip('Walk','--walk',raceWalk,function(){raceWalk=!raceWalk;save('fm.walk',raceWalk);renderChips();}));
  vehicles.forEach(function(v){
    var b=chip(v.name,v.color,v.on,function(e){
      if(e.target.classList.contains('edit'))return;
      v.on=!v.on;save('fm.vehicles',vehicles);renderChips();
    },' <span class="kmh">'+v.speed+' km/h</span> <span class="edit">✎</span>');
    b.querySelector('.edit').onclick=function(e){e.stopPropagation();openVeh(v);};
    box.appendChild(b);
  });
  box.appendChild(chip('Car','--car',raceCar,function(){raceCar=!raceCar;save('fm.car',raceCar);renderChips();}));
  box.appendChild(chip('Public transport','--rail',raceTransit,function(){raceTransit=!raceTransit;save('fm.transit',raceTransit);renderChips();}));

  var tb=$('transitChips'); tb.innerHTML='';
  TRANSIT_MODES.forEach(function(m){
    tb.appendChild(chip(m.label,m.color,m.on,function(){
      m.on=!m.on;var o={};TRANSIT_MODES.forEach(function(x){o[x.id]=x.on;});save('fm.tmodes',o);renderChips();
    }));
  });
  var sb=$('shareChips'); sb.innerHTML='';
  sb.appendChild(chip('Use share bikes & scooters','--escooter',useShare,function(){
    useShare=!useShare;save('fm.share',useShare);renderChips();
  }));
}
var editing=null;
function openVeh(v){
  editing=v;
  $('vName').value=v?v.name:'';
  $('vSpeed').value=v?v.speed:20;
  $('vColor').value=v?v.color:'--escooter';
  $('vDelete').style.display=v?'':'none';
  $('vehDlg').showModal();
}
$('addVeh').onclick=function(){openVeh(null);};
$('vCancel').onclick=function(){$('vehDlg').close();};
$('vSave').onclick=function(){
  var name=$('vName').value.trim()||'Vehicle';
  var speed=parseFloat($('vSpeed').value);
  if(!(speed>0)){$('vSpeed').focus();return;}
  speed=Math.min(60,Math.max(3,speed));
  if(editing){editing.name=name;editing.speed=speed;editing.color=$('vColor').value;}
  else vehicles.push({id:'v'+Date.now(),name:name,speed:speed,color:$('vColor').value,on:true});
  save('fm.vehicles',vehicles);renderChips();$('vehDlg').close();
};
$('vDelete').onclick=function(){
  if(editing){vehicles=vehicles.filter(function(x){return x!==editing;});save('fm.vehicles',vehicles);renderChips();}
  $('vehDlg').close();
};
renderChips();

/* ---------- geocoding ---------- */
var picked={from:null,to:null,pit:null};
function nominatim(q){
  var c=map.getCenter();
  var vb=[c.lng-.4,c.lat+.3,c.lng+.4,c.lat-.3].join(',');
  return fetch(NOM+'search?'+new URLSearchParams({q:q,format:'jsonv2',limit:6,addressdetails:1,viewbox:vb,bounded:0}),
    {headers:{Accept:'application/json'}})
    .then(function(r){if(!r.ok)throw new Error('address lookup failed');return r.json();})
    .then(function(a){return a.map(function(p){
      return {lat:+p.lat,lon:+p.lon,name:p.name||p.display_name.split(',')[0],
        detail:p.display_name.split(',').slice(1,4).join(',').trim(),kind:'address'};});});
}
function motisGeocode(q){
  return fetch(MOTIS+'v1/geocode?'+new URLSearchParams({q:q,limit:5}))
    .then(function(r){return r.ok?r.json():[];})
    .then(function(a){return a.map(function(p){
      return {lat:p.lat,lon:p.lon,name:p.name,
        detail:(p.areas||[]).filter(function(x){return x.name;}).slice(0,3).map(function(x){return x.name;}).join(', '),
        kind:p.type==='STOP'?'stop':'place'};});});
}
function lookup(q){
  return Promise.allSettled([nominatim(q),motisGeocode(q)]).then(function(res){
    var nom=res[0].status==='fulfilled'?res[0].value:[];
    var mot=res[1].status==='fulfilled'?res[1].value:[];
    var stationy=/\b(station|stn|terminal|airport|depot|platform|av|ave)\b/i.test(q)&&!/\d/.test(q);
    var order=stationy?[mot,nom]:[nom,mot];
    var out=[],seen={};
    order.forEach(function(list){list.forEach(function(p){
      if(p.lat==null)return;
      var k=p.lat.toFixed(4)+','+p.lon.toFixed(4);
      if(seen[k])return;seen[k]=1;out.push(p);
    });});
    if(!out.length)throw new Error('no match for "'+q+'"');
    return out.slice(0,8);
  });
}
function reverse(lat,lon){
  return fetch(NOM+'reverse?'+new URLSearchParams({lat:lat,lon:lon,format:'jsonv2'}))
    .then(function(r){return r.json();})
    .then(function(j){return j.display_name?j.display_name.split(',').slice(0,3).join(',').trim():null;})
    .catch(function(){return null;});
}
function wireGeocode(inputId,suggId,key){
  var input=$(inputId),box=$(suggId),timer=null,seq=0;
  input.addEventListener('input',function(){
    picked[key]=null;clearTimeout(timer);
    var q=input.value.trim();
    if(q.length<3){box.hidden=true;return;}
    var my=++seq;
    timer=setTimeout(function(){
      lookup(q).then(function(list){
        if(my!==seq)return;
        box.innerHTML='';
        list.forEach(function(p){
          var el=document.createElement('div');
          el.innerHTML='<span class="kind">'+esc(p.kind)+'</span><span>'+esc(p.name)+'</span>'+(p.detail?'<small>'+esc(p.detail)+'</small>':'');
          el.onmousedown=function(e){e.preventDefault();};
          el.onclick=function(){picked[key]=p;input.value=p.name+(p.detail?', '+p.detail.split(',')[0]:'');box.hidden=true;};
          box.appendChild(el);
        });
        box.hidden=false;
      }).catch(function(){box.hidden=true;});
    },450);
  });
  input.addEventListener('blur',function(){setTimeout(function(){box.hidden=true;},150);});
}
['from','to','pit'].forEach(function(k){wireGeocode(k+'In',k+'Sugg',k);});
function resolve(key,inputId,required){
  if(picked[key])return Promise.resolve(picked[key]);
  var q=$(inputId).value.trim();
  if(!q){if(required)return Promise.reject(new Error('Enter a '+(key==='from'?'start':'destination')));return Promise.resolve(null);}
  return lookup(q).then(function(list){
    picked[key]=list[0];
    $(inputId).value=list[0].name+(list[0].detail?', '+list[0].detail.split(',')[0]:'');
    return list[0];
  });
}

